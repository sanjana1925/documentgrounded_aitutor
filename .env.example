# Google Gemini API key (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: if set, /upload, /agent and /documents need an X-API-Key header
API_KEY=

# Password for the System Benchmark on the Evaluation page (stays locked while empty)
BENCHMARK_PASSWORD=

# Prompt-injection detection (optional; defaults are tuned, see project-docs/Guardrails.md)
# INJECTION_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2   # use all-MiniLM-L6-v2 for a smaller English-only model
# INJECTION_SEMANTIC_FLAG=0.62
# INJECTION_SEMANTIC_BLOCK=0.68
